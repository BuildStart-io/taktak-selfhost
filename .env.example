# ============================================================
# TakTak self-hosted — edge function / server-side environment
# Copy to .env and fill in. NEVER commit the filled version.
# ============================================================

# --- Supabase (your own instance) ---------------------------
# Internal URL used BY the edge functions (inside docker network)
SUPABASE_URL=http://kong:8000
# Public URL used by the browser and by external webhooks
PUBLIC_SUPABASE_URL=https://api.your-domain.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:<password>@db:5432/postgres

# --- AI: Lovable AI Gateway via the ai-proxy (ONLY Lovable dep) ----
# Your self-hosted functions never hold LOVABLE_API_KEY. They call the
# `ai-proxy` edge function that stays hosted on Lovable, authenticating
# with BOT_API_KEY. The proxy swaps in LOVABLE_API_KEY server-side.
#
#   AI_GATEWAY_URL : the ai-proxy endpoint (replaces the gateway base URL)
#   LOVABLE_API_KEY: set this to your BOT_API_KEY value. The functions send
#                    it as `Authorization: Bearer ...`, which is exactly what
#                    ai-proxy expects — no code change needed.
AI_GATEWAY_URL=https://<your-lovable-project>.supabase.co/functions/v1/ai-proxy
LOVABLE_API_KEY=<your BOT_API_KEY value>

# Notion analytics (optional) goes through Lovable's CONNECTOR gateway, which
# ai-proxy does not cover. Self-hosted: use a direct Notion integration token.

# --- WhatsApp: Wasender (currently the live provider) -------
WASENDER_API_TOKEN=
WASENDER_PERSONAL_ACCESS_TOKEN=

# --- WhatsApp: WAHA (currently disabled, kept for failover) -
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_ENABLED=false

# --- Object storage (MinIO / S3) ----------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=listing-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL used in image links written to the DB
S3_PUBLIC_URL=https://cdn.your-domain.com

# --- Payments: OnePay ---------------------------------------
ONEPAY_APP_ID=
ONEPAY_APP_TOKEN=
ONEPAY_HASH_SALT=
ONEPAY_STATUS_URL=

# --- CRM proxy (optional) -----------------------------------
CRM_PROXY_URL=
CRM_PROXY_SECRET=

# --- Notion analytics (optional) ----------------------------
NOTION_TOKEN=
NOTION_DATABASE_ID=
